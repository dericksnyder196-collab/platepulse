# Copy this file to .env for local development. Never commit .env.
# On Render, set these in the service's Environment tab instead.

NODE_ENV=development
PORT=3000   

# --- Database (Aiven MySQL) ---
# Option A: one URI (recommended). Percent-encode special characters in the password.
# DATABASE_URL=mysql://avnadmin:PASSWORD@your-service.aivencloud.com:12345/defaultdb

# Option B: separate values (used only if DATABASE_URL is not set)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# SSL is on automatically for non-local hosts. Set DB_SSL=false for a local MySQL.
# DB_SSL=false
# Aiven CA certificate: a file path (Render Secret File) OR the PEM text itself.
# DB_SSL_CA_PATH=/etc/secrets/ca.pem
# DB_SSL_CA=

# Keep this low: Aiven plans cap total connections.
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m

# --- Two-factor authentication ---
# Encrypts stored authenticator secrets. 64 hex characters (32 bytes). Back it up in a password
# manager: losing it locks every enrolled account out of two-factor sign-in.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
MFA_ISSUER=PlatePulse
# MFA_MAX_FAILED_ATTEMPTS=5
# MFA_LOCKOUT_MINUTES=15
# LOGIN_RATE_LIMIT_MAX=10
# MFA_RATE_LIMIT_MAX=20

# --- Owner area ---
# OWNER_SESSION_IDLE_MINUTES=30
# OWNER_SESSION_ABSOLUTE_HOURS=8
# Optional: only these IP addresses can reach /owner and /api/v1/owner (comma-separated).
# OWNER_ALLOWED_IPS=

# --- Web ---
# Comma-separated list. Leave empty for same-origin only.
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BODY_LIMIT=10kb

# --- Business defaults ---
DEFAULT_CURRENCY=RWF
DEFAULT_LANGUAGE=en
