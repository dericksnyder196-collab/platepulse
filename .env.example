# Copy this file to .env for local development. Never commit .env.
# On Render, set these in the service's Environment tab instead.

NODE_ENV=development
PORT=3000   

# --- Database (Aiven MySQL) ---
# Option A: one URI (recommended). Percent-encode special characters in the password.
# DATABASE_URL=mysql://avnadmin:PASSWORD@your-service.aivencloud.com:12345/defaultdb

# Option B: separate values (used only if DATABASE_URL is not set)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# SSL is on automatically for non-local hosts. Set DB_SSL=false for a local MySQL.
# DB_SSL=false
# Aiven CA certificate: a file path (Render Secret File) OR the PEM text itself.
# DB_SSL_CA_PATH=/etc/secrets/ca.pem
# DB_SSL_CA=

# Keep this low: Aiven plans cap total connections.
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m

# --- Web ---
# Comma-separated list. Leave empty for same-origin only.
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BODY_LIMIT=10kb

# --- Business defaults ---
DEFAULT_CURRENCY=RWF
DEFAULT_LANGUAGE=en
